# ─── API (set automatically in docker-compose.yml) ────────────────────────────
DATABASE_URL=postgresql+asyncpg://apex:apex@db:5432/storedb
REDIS_URL=redis://redis:6379/0
APP_ENV=local
LOG_LEVEL=INFO

# ─── Pipeline Tuning ──────────────────────────────────────────────────────────
# How many video frames to skip between detections.
# Lower = more accurate, slower.  Higher = faster, less accurate.
# Recommended range: 5 (slow/accurate) to 30 (fast/approximate)
FRAME_STRIDE=15

# Re-identification similarity threshold (0.0–1.0).
# Higher values = stricter matching (fewer cross-camera links).
REID_THRESHOLD=0.75

# Max seconds between a visitor's last seen time and their re-appearance
# before they are treated as a new visitor (cross-camera linking window).
CROSS_CAMERA_LINK_SECONDS=120

# Minimum tracked duration (seconds) inside the store before a visitor is counted.
# Filters out brief pass-by detections.
MIN_ENTRY_TRACK_SECONDS=4

# De-duplication window (seconds) for entry events from multiple entry cameras
# covering the same physical door.
ENTRY_DEDUPE_SECONDS=2.5

# Set to 1 to disable YOLOv8 and use the OpenCV fallback detector (no GPU needed).
# Set to 0 (default) to use YOLOv8 for higher accuracy.
PIPELINE_NO_YOLO=0

# ─── Adding a new store ───────────────────────────────────────────────────────
# 1. Add the store to data/store_layout.json (store_id, cameras, zones, clip_start).
# 2. Drop video clips into data/<source_dir>/ as referenced in store_layout.json.
# 3. Drop the POS CSV for the new store in data/ (any file matching POS*.csv).
#    Make sure the store_id column matches the store_id in store_layout.json.
#    If they don't match, run:
#      python scripts/normalize_data.py --store-id-map OLD_ID=NEW_ID
# 4. Run: docker compose up --build
